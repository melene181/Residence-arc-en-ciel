<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hôtel Arc en Ciel</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-white text-gray-800">
  <!-- Header -->
  <header class="bg-gradient-to-r from-indigo-200 to-blue-100 shadow-md">
    <div class="container mx-auto px-4 py-6 flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-700">Hôtel Arc en Ciel</h1>
      <nav class="space-x-6">
        <a href="#accueil" class="text-gray-700 font-medium">Accueil</a>
        <a href="#chambres" class="text-gray-700 font-medium">Chambres</a>
        <a href="#services" class="text-gray-700 font-medium">Services</a>
        <a href="#reservation" class="text-gray-700 font-medium">Réservation</a>
        <a href="#contact" class="text-gray-700 font-medium">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Section Accueil -->
  <section id="accueil" class="text-center py-16 px-4 bg-blue-50">
    <h2 class="text-4xl font-bold mb-4">Bienvenue à l’Hôtel Arc en Ciel</h2>
    <p class="max-w-3xl mx-auto text-lg text-gray-600">
      Découvrez le charme discret de notre établissement niché au cœur de Dieppe. Avec des chambres élégantes, un service irréprochable et une atmosphère apaisante, Arc en Ciel est votre destination idéale pour une escapade relaxante. Réservez dès maintenant et vivez l’expérience que vous méritez.
    </p>
  </section>

  <!-- Section Chambres -->
  <section id="chambres" class="py-16 px-4">
    <h2 class="text-3xl font-bold text-center mb-10">Nos Chambres</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <div class="shadow-lg rounded-xl overflow-hidden">
        <img src="standard.jpg" alt="Chambre Standard" />
        <div class="p-4">
          <h3 class="text-xl font-semibold">Chambre Standard – 105€</h3>
          <p class="text-gray-600">Confort simple et chaleureux pour un séjour agréable.</p>
        </div>
      </div>
      <div class="shadow-lg rounded-xl overflow-hidden">
        <img src="vip.jpg" alt="Suite VIP" />
        <div class="p-4">
          <h3 class="text-xl font-semibold">Suite VIP – 180€</h3>
          <p class="text-gray-600">Spacieuse et élégante, idéale pour se détendre avec style.</p>
        </div>
      </div>
      <div class="shadow-lg rounded-xl overflow-hidden">
        <img src="vvip.jpg" alt="Suite VVIP" />
        <div class="p-4">
          <h3 class="text-xl font-semibold">Suite VVIP – 240€</h3>
          <p class="text-gray-600">Le summum du luxe avec vue exceptionnelle et prestations haut de gamme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Services -->
  <section id="services" class="py-16 px-4 bg-gray-50">
    <h2 class="text-3xl font-bold text-center mb-10">Nos Services</h2>
    <div class="max-w-4xl mx-auto text-center text-gray-700 space-y-4">
      <p>Petit-déjeuner inclus – 20€</p>
      <p>Wi-Fi haut débit gratuit</p>
      <p>Parking privé sécurisé</p>
      <p>Spa & espace bien-être</p>
      <p>Piscine intérieure chauffée</p>
    </div>
  </section>

  <!-- Section Réservation -->
  <section id="reservation" class="py-16 px-4">
    <h2 class="text-3xl font-bold text-center mb-10">Réserver une chambre</h2>
    <form action="mailto:melenemoline@gmail.com" method="POST" enctype="text/plain" class="max-w-2xl mx-auto space-y-4">
      <input type="text" name="Nom" placeholder="Votre nom" class="w-full p-2 border rounded" required />
      <input type="email" name="Email" placeholder="Votre e-mail" class="w-full p-2 border rounded" required />
      <input type="date" name="Date d'arrivée" class="w-full p-2 border rounded" required />
      <input type="date" name="Date de départ" class="w-full p-2 border rounded" required />
      <select name="Type de chambre" class="w-full p-2 border rounded">
        <option>Chambre Standard</option>
        <option>Suite VIP</option>
        <option>Suite VVIP</option>
      </select>
      <textarea name="Message" placeholder="Message (optionnel)" class="w-full p-2 border rounded"></textarea>
      <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded">Envoyer</button>
    </form>
  </section>

  <!-- Section Contact -->
  <section id="contact" class="py-16 px-4 bg-blue-50">
    <h2 class="text-3xl font-bold text-center mb-10">Nous contacter</h2>
    <div class="text-center space-y-2 text-gray-700">
      <p>Adresse : 28 Pl. Henri Dunant, 76200 Dieppe, France</p>
      <p>Email : melenemoline@gmail.com</p>
      <p>Check-in : 15h00 | Check-out : 11h00</p>
      <p>Annulation gratuite jusqu’à 24h avant l’arrivée</p>
    </div>
  </section>

  <footer class="text-center py-6 text-gray-500">
    © 2025 Hôtel Arc en Ciel – Tous droits réservés
  </footer>
</body>
</html>
